@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Dashboard</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ModalsShared.css" asp-append-version="true" />
    <link href="~/css/Dashboard.css" rel="stylesheet" />
    <link href="~/css/navbarlogin.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
</head>

<body>

    <div class="dash">

        <!-- HEADER -->
        <div class="dash-header">

            <div></div> <!-- espacio izquierda -->

            <div class="dash-logo-center">
                <img src="~/imagenes/logo.png" class="dash-logo" />
            </div>

            <div class="dash-user-box">
                <div id="dashboardUser"></div>

                <button class="btn-logout" onclick="logout()">
                    <i class="fa fa-sign-out"></i>
                </button>
            </div>

        </div>

        <!-- GRID -->
        <div class="dash-grid" id="dashboardModulos"></div>

    </div>

    <partial name="~/Views/Utils/Modals.cshtml" />
    <partial name="~/Views/Shared/Partials/ModalsConfiguracionSistema.cshtml" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/Permisos.js?v=1.16"></script>
    <script src="~/js/NavBarLogin.js?v=1.16" asp-append-version="true"></script>
    <script src="~/js/Dashboard.js?v=1.17"></script>

</body>
</html>