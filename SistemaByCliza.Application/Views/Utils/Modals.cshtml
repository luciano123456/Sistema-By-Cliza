<!-- Host de toasts (se completa desde site.js; se deja por si hace falta anclar) -->
<div id="appToastHost" class="app-toast-host" aria-live="polite" aria-relevant="additions"></div>

<!-- Modal Confirmar -->
<div class="modal fade w-100" id="modalConfirmar" tabindex="-1" aria-labelledby="modalConfirmarLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content text-white app-modal-dark">
            <div class="modal-header border-0 bg-warning bg-opacity-10 colorEncabezado">
                <i class="fa fa-question-circle text-warning fs-2 me-2"></i>
                <h5 class="modal-title text-white fw-bold" id="modalConfirmarLabel">Confirmación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body text-center">
                <p id="modalConfirmarMensaje" class="fs-4 fw-semibold m-0 text-white text-wrap">
                    ¿Estás seguro que deseas continuar?
                </p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary px-4" id="btnModalConfirmarAceptar">Sí, continuar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal post-guardado NuevoModif: listado vs seguir editando -->
<div class="modal fade w-100" id="modalDespuesGuardar" tabindex="-1" aria-labelledby="modalDespuesGuardarLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content text-white app-modal-dark">
            <div class="modal-header border-0 bg-success bg-opacity-10 colorEncabezado">
                <i class="fa fa-check-circle text-success fs-2 me-2"></i>
                <h5 class="modal-title text-white fw-bold" id="modalDespuesGuardarLabel">Guardado</h5>
            </div>
            <div class="modal-body text-center">
                <p id="modalDespuesGuardarMensaje" class="text-success fs-4 fw-semibold m-0 text-white text-wrap"></p>
                <p class="text-white-50 mt-3 mb-0">¿Qué deseás hacer ahora?</p>
            </div>
            <div class="modal-footer border-0 justify-content-center flex-wrap gap-2">
                <button type="button" class="btn btn-outline-light px-4" id="btnDespuesGuardarListado">
                    <i class="fa fa-list me-1"></i> Ir a la pantalla principal
                </button>
                <button type="button" class="btn btn-success px-4" id="btnDespuesGuardarEditar">
                    <i class="fa fa-pencil me-1"></i> Seguir editando
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal sesion por expirar (ultimos 5 minutos) -->
<div class="modal fade" id="modalSessionPorExpirar" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-white rp-session-renew-modal app-modal-dark">
            <div class="modal-header border-0 bg-warning bg-opacity-10 colorEncabezado">
                <i class="fa fa-hourglass-half text-warning fs-2 me-2"></i>
                <h5 class="modal-title text-white fw-bold">Sesion por expirar</h5>
            </div>
            <div class="modal-body text-center">
                <p class="fs-5 fw-semibold m-0 text-white">Tu sesion esta por finalizar</p>
                <p class="text-muted small mt-2 mb-3">Quedan menos de 5 minutos. Podes renovarla para seguir trabajando sin interrupciones.</p>
                <div class="rp-session-renew-countdown">
                    <span class="rp-session-renew-countdown-label">Tiempo restante</span>
                    <strong id="modalSessionPorExpirarCountdown">--:--</strong>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center flex-wrap gap-2">
                <button type="button" class="btn btn-outline-light px-3" id="btnSessionPorExpirarContinuar" data-bs-dismiss="modal">
                    Continuar
                </button>
                <button type="button" class="btn btn-warning px-4" id="btnSessionRenovar">
                    <i class="fa fa-refresh me-1"></i> Renovar sesion
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal sesion expirada -->
<div class="modal fade" id="modalSessionExpirada" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-white app-modal-dark">
            <div class="modal-header border-0 bg-danger bg-opacity-10 colorEncabezado">
                <i class="fa fa-clock-o text-danger fs-2 me-2"></i>
                <h5 class="modal-title text-white fw-bold">Sesion expirada</h5>
            </div>
            <div class="modal-body text-center">
                <p class="fs-5 fw-semibold m-0 text-white">La sesion ha expirado</p>
                <p class="text-muted small mt-2 mb-0">Volve a iniciar sesion para continuar.</p>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-danger px-4" id="btnSessionExpiradaAceptar">Aceptar</button>
            </div>
        </div>
    </div>
</div>
