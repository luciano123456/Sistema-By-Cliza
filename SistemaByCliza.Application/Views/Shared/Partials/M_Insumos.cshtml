@* Modal alta insumo (catálogo) — reutilizable; mismos ids insABM_* que consume OrdenesCorteNuevoModif. *@
<div class="modal fade" id="modalInsumoABM" tabindex="-1" aria-labelledby="modalInsumoABMLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl modal-insumos-xl-wide">
        <div class="modal-content border-0 shadow">
            <div class="modal-header colorEncabezado border-0">
                <h5 class="modal-title fw-bold" id="modalInsumoABMLabel">
                    <i class="fa fa-wrench me-2"></i> Nuevo Insumo
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <form id="formInsumoABM" class="row g-3">
                    <input type="hidden" id="insABM_Id" />

                    <div class="col-md-3">
                        <label class="form-label">Código</label>
                        <input type="text" class="form-control editable-field" id="insABM_Codigo" />
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Descripción</label>
                        <input type="text" class="form-control editable-field" id="insABM_Descripcion" />
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label">Costo Unitario</label>
                        <input type="number" step="0.01" min="0" class="form-control editable-field" id="insABM_Costo" />
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Categoría</label>
                        <div class="pr-select-plus pr-select-plus--flex">
                            <div class="pr-select-plus__grow">
                                <select id="insABM_Categoria" class="form-select editable-field" data-s2-parent="#modalInsumoABM">
                                    <option value="">Seleccione</option>
                                </select>
                            </div>
                            <button type="button" id="insABM_btnPlusCategoria" class="pr-btn-plus pr-btn-plus--flex-end pr-atajo-catalogo" title="Nueva categoría">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label">Proveedor</label>
                        <div class="pr-select-plus pr-select-plus--flex">
                            <div class="pr-select-plus__grow">
                                <select id="insABM_Proveedor" class="form-select editable-field" data-s2-parent="#modalInsumoABM">
                                    <option value="">Seleccione</option>
                                </select>
                            </div>
                            <button type="button" id="insABM_btnPlusProveedor" class="pr-btn-plus pr-btn-plus--flex-end pr-atajo-catalogo" title="Nuevo proveedor">
                                <i class="fa fa-plus"></i>
                            </button>
                        </div>
                        <div class="invalid-feedback">Campo obligatorio</div>
                    </div>

                    <div id="insABM_Error" class="alert alert-danger d-none col-12">
                        Debes completar los campos obligatorios.
                    </div>
                </form>
            </div>

            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times me-1"></i> Cancelar
                </button>
                <button type="button" id="btnGuardarInsumoABM" class="btn btn-success" onclick="guardarInsumoABM()">
                    <i class="fa fa-check me-1"></i> Registrar
                </button>
            </div>
        </div>
    </div>
</div>
