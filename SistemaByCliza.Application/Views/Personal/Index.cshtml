@{
    ViewData["Title"] = "Personal";
}

@section Estilos {
    <!-- DataTables -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/fixedheader/3.2.2/css/fixedHeader.dataTables.min.css" />
    <!-- Icons + Select2 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/4.7.0/css/font-awesome.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" />
    <link href="~/css/Productos.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/personal.css" rel="stylesheet" />

}

<div class="container page-99 mt-layout-100">
    <!-- Header -->
    <div class="cc-header shadow-lg rounded-4 p-4 mb-4">
        <div class="d-flex align-items-center gap-3 flex-wrap">
            <div class="d-flex align-items-center gap-3">
                <span class="cc-badge"><i class="fa fa-id-badge"></i></span>
                <div>
                    <h2 class="m-0 fw-800">Personal</h2>
                    <small class="text-muted-cc">Gestión de personal</small>
                </div>
            </div>

            <div class="ms-auto d-flex gap-3 flex-wrap kpi-solo-rol-finanzas">
                <div class="cc-stat">
                    <div class="label">Total personal</div>
                    <div class="value kpi-azul" id="kpiTotalPersonal">0</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Grilla -->
    <div class="row g-4">
        <div class="col-12">
            <div class="card-glass p-3">
                <div class="tabla-wrap position-relative">
                    <div class="tabla-controls-top d-flex gap-2">
                        <div class="dropdown">
                            <button class="btn btn-secondary dropdown-toggle d-flex align-items-center" type="button" id="btnConfigCols"
                                    data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa fa-cog me-2"></i> Config. Columnas
                            </button>
                            <ul class="dropdown-menu" id="configColumnasMenu" aria-labelledby="btnConfigCols"></ul>
                        </div>
                        <button type="button" class="btn btn-primary" data-modulo="Personal" data-permiso="crear" onclick="nuevoPersonal()">
                            <i class="fa fa-plus me-1"></i> Nuevo
                        </button>
                    </div>

                    <div class="dt-dark-wrap">
                        <table class="w-100 dt-dark display nowrap compact" id="grd_Personal">
                            <thead>
                                <tr>
                                    <th></th>
                                    <th>Nombre</th>
                                    <th>Teléfono</th>
                                    <th>Teléfono Alternativo</th>
                                    <th>DNI</th>
                                    <th>CUIT</th>
                                    <th>Condición IVA</th>
                                    <th>Domicilio</th>
                                    <th>Provincia</th>
                                    <th>Localidad</th>
                                    <th>Email</th>
                                    <th>Banco</th>
                                    <th>Alias</th>
                                    <th>CBU</th>
                                    <th>Puesto</th>
                                    <th>Fecha Ingreso</th>
                                    <th>Fecha Retiro</th>
                                    <th>Sueldo Mensual</th>
                                    <th>Días Laborales</th>
                                    <th>Valor Día</th>
                                    <th>Hs Laborales</th>
                                    <th>Valor Hora</th>
                                    <th>Sucursal</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <div class="tabla-footer d-flex align-items-center justify-content-between">
                        <div></div>
                        <div class="acciones-externas d-flex justify-content-end mt-2 gap-2">
                            <!-- (opcional) botones extra -->
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<partial name="~/Views/Shared/Partials/M_Personal.cshtml" />

<partial name="~/Views/Utils/Modals.cshtml" />

@section Scripts {
    <!-- jQuery (si el layout ya lo incluye, no dupliques) -->
    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/fixedheader/3.2.2/js/dataTables.fixedHeader.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>

    <!-- Dependencias Botones -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>

    <!-- Select2 -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- utilidades del proyecto -->
    <script src="~/js/site.js"></script>
    <script src="~/js/utils/moment.js"></script>

    <!-- Modal Personal (reutilizable) + grilla índice -->
    <script src="~/js/Entities/M_Personal.js?v=1.0"></script>
    <script src="~/js/Personal.js?v=3.2"></script>
}
